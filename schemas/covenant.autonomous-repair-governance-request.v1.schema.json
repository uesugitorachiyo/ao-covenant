{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "covenant.autonomous-repair-governance-request.v1",
  "title": "AO Covenant Autonomous Repair Governance Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mode",
    "repository"
  ],
  "properties": {
    "schema_version": {
      "const": "covenant.autonomous-repair-governance-request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "mode": {
      "enum": [
        "discovery",
        "write"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "ownership_class_assertion": {
      "enum": [
        "sole_control",
        "team",
        "external"
      ]
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "push_operator_fork",
        "open_upstream_draft_pr",
        "open_ready_pr",
        "request_merge_queue",
        "auto_merge"
      ]
    },
    "current_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changed_path_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "approved_action_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_envelope": {
      "$ref": "#/$defs/architecture_run_envelope"
    },
    "candidate_decision": {
      "$ref": "#/$defs/architecture_candidate_decision"
    },
    "governance_decision": {
      "$ref": "#/$defs/architecture_governance_decision"
    },
    "reviewer_independence": {
      "$ref": "#/$defs/architecture_reviewer_independence"
    },
    "github_action_digest": {
      "$ref": "#/$defs/architecture_github_action_digest"
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {
          "const": "discovery"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "ownership_class_assertion"
            ]
          },
          {
            "required": [
              "issue_number"
            ]
          },
          {
            "required": [
              "action"
            ]
          },
          {
            "required": [
              "current_base_sha"
            ]
          },
          {
            "required": [
              "changed_path_classes"
            ]
          },
          {
            "required": [
              "approved_action_digest"
            ]
          },
          {
            "required": [
              "run_envelope"
            ]
          },
          {
            "required": [
              "candidate_decision"
            ]
          },
          {
            "required": [
              "governance_decision"
            ]
          },
          {
            "required": [
              "reviewer_independence"
            ]
          },
          {
            "required": [
              "github_action_digest"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "issue_number",
        "action",
        "current_base_sha",
        "changed_path_classes",
        "approved_action_digest",
        "run_envelope",
        "candidate_decision",
        "governance_decision",
        "reviewer_independence",
        "github_action_digest"
      ],
      "properties": {
        "mode": {
          "const": "write"
        },
        "issue_number": true,
        "action": true,
        "current_base_sha": true,
        "changed_path_classes": true,
        "approved_action_digest": true,
        "run_envelope": true,
        "candidate_decision": true,
        "governance_decision": true,
        "reviewer_independence": true,
        "github_action_digest": true
      }
    }
  ],
  "$defs": {
    "architecture_run_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "loop",
        "trigger",
        "discovery",
        "budgets",
        "governance",
        "routing",
        "created_at",
        "expires_at",
        "canonical_digest",
        "predecessor_digest",
        "lineage",
        "stop_conditions",
        "terminal_statuses"
      ],
      "properties": {
        "schema": {
          "const": "ao.architecture.autonomous-issue-repair.run-envelope.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
        },
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal",
            "trigger",
            "discovery",
            "action",
            "verification",
            "state",
            "human_gates"
          ],
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "trigger": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "discovery": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "human_gates": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "canonical_url",
            "repository",
            "default_branch",
            "pinned_base_commit"
          ],
          "properties": {
            "mode": {
              "enum": [
                "explicit_issue",
                "issue_list"
              ]
            },
            "canonical_url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues(/[1-9][0-9]*)?$"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "default_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "pinned_base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_limit",
            "candidate_limit",
            "selected_limit"
          ],
          "properties": {
            "snapshot_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "candidate_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "selected_limit": {
              "const": 1
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_clock_seconds",
            "clone_count",
            "test_runs",
            "retry_count",
            "repair_count",
            "publication_count"
          ],
          "properties": {
            "wall_clock_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "clone_count": {
              "type": "integer",
              "minimum": 0
            },
            "test_runs": {
              "type": "integer",
              "minimum": 1
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "repair_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "publication_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownership_class",
            "allowed_actions",
            "denied_actions",
            "sole_control_auto_merge_opt_in"
          ],
          "properties": {
            "ownership_class": {
              "enum": [
                "sole_control",
                "team",
                "external",
                "unknown"
              ]
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "read_public_metadata",
                  "clone_public_repository",
                  "push_operator_fork",
                  "open_upstream_draft_pr",
                  "open_ready_pr",
                  "request_merge_queue",
                  "auto_merge"
                ]
              }
            },
            "denied_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "push_upstream",
                  "open_ready_pr",
                  "mark_ready",
                  "approve_review",
                  "merge",
                  "mutate_issue",
                  "publish_release"
                ]
              }
            },
            "sole_control_auto_merge_opt_in": {
              "type": "boolean"
            }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_branch",
            "pinned_base_commit",
            "fork_owner",
            "repair_branch",
            "protected_path_classes",
            "required_checks"
          ],
          "properties": {
            "default_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "pinned_base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "fork_owner": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "repair_branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]{1,255}$"
            },
            "protected_path_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required_checks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "canonical_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predecessor_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "predecessor_run_id",
            "predecessor_digest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "origin",
                "narrower_successor"
              ]
            },
            "predecessor_run_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
            },
            "predecessor_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "policy_ambiguity",
              "security_sensitive",
              "credential_required",
              "lease_conflict",
              "digest_mismatch",
              "required_check_conflict",
              "budget_exhausted",
              "unauthorized_external_write",
              "concurrent_repository_mutation"
            ]
          }
        },
        "terminal_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "completed",
              "no_eligible_issue",
              "operator_action_required",
              "blocked",
              "expired",
              "cancelled"
            ]
          }
        }
      }
    },
    "architecture_candidate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "repository",
        "base_sha",
        "issue_number",
        "rank",
        "decision",
        "eligibility",
        "reason_codes",
        "evidence_digests",
        "expected_behavior_source",
        "decided_at",
        "decision_digest"
      ],
      "properties": {
        "schema": {
          "const": "ao.architecture.autonomous-issue-repair.candidate-decision.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "decision": {
          "enum": [
            "eligible",
            "selected",
            "excluded"
          ]
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open_bug",
            "target_in_repository",
            "no_existing_fix",
            "current_head_unfixed",
            "security_sensitive",
            "public_reproduction_feasible",
            "deterministic_local_reproduction",
            "expected_behavior_grounded",
            "bounded_policy_compatible"
          ],
          "properties": {
            "open_bug": {
              "type": "boolean"
            },
            "target_in_repository": {
              "type": "boolean"
            },
            "no_existing_fix": {
              "type": "boolean"
            },
            "current_head_unfixed": {
              "type": "boolean"
            },
            "security_sensitive": {
              "type": "boolean"
            },
            "public_reproduction_feasible": {
              "type": "boolean"
            },
            "deterministic_local_reproduction": {
              "type": "boolean"
            },
            "expected_behavior_grounded": {
              "type": "boolean"
            },
            "bounded_policy_compatible": {
              "type": "boolean"
            }
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "expected_behavior_source": {
          "enum": [
            "tests",
            "documentation",
            "protocol",
            "maintainer_statement",
            "unavailable"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "architecture_governance_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "repository",
        "base_sha",
        "head_sha",
        "governance_class",
        "classification_sources",
        "push_target",
        "pull_request_mode",
        "merge",
        "protected_path_touched",
        "required_checks",
        "action_digest_required",
        "decided_at",
        "decision_digest"
      ],
      "properties": {
        "schema": {
          "const": "ao.architecture.autonomous-issue-repair.governance-decision.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "governance_class": {
          "enum": [
            "sole_control",
            "team",
            "external",
            "unknown"
          ]
        },
        "classification_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "repository_policy",
              "branch_rules",
              "codeowners",
              "operator_envelope",
              "unknown_default"
            ]
          }
        },
        "push_target": {
          "enum": [
            "authorized_operator_repository",
            "policy_authorized_branch",
            "operator_owned_fork"
          ]
        },
        "pull_request_mode": {
          "enum": [
            "draft_or_ready_by_policy",
            "upstream_draft_only"
          ]
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorized",
            "mode",
            "approval_kind",
            "approval_head_sha",
            "auto_merge_opt_in",
            "branch_protection_bypassed"
          ],
          "properties": {
            "authorized": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "never",
                "manual",
                "merge_queue",
                "auto_merge"
              ]
            },
            "approval_kind": {
              "enum": [
                "none",
                "independent_human",
                "codeowner"
              ]
            },
            "approval_head_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "auto_merge_opt_in": {
              "type": "boolean"
            },
            "branch_protection_bypassed": {
              "const": false
            }
          }
        },
        "protected_path_touched": {
          "type": "boolean"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "conclusion",
              "head_sha"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "conclusion": {
                "enum": [
                  "success",
                  "failure",
                  "pending",
                  "missing"
                ]
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "action_digest_required": {
          "const": true
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "architecture_reviewer_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "subject_digest",
        "reviewer_id",
        "status",
        "deterministic_tests_primary",
        "satisfies_team_merge_gate",
        "reviewed_at",
        "review_digest"
      ],
      "properties": {
        "schema": {
          "const": "ao.architecture.autonomous-issue-repair.reviewer-independence.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "independent",
            "same_vendor",
            "unavailable",
            "unverified"
          ]
        },
        "deterministic_tests_primary": {
          "const": true
        },
        "satisfies_team_merge_gate": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "architecture_github_action_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "repository",
        "issue_number",
        "base_sha",
        "head_sha",
        "fork",
        "branch",
        "pr_title_digest",
        "pr_body_digest",
        "diff_digest",
        "required_checks",
        "action",
        "approved_at",
        "expires_at",
        "run_envelope_digest",
        "candidate_decision_digest",
        "governance_decision_digest",
        "reviewer_independence_digest",
        "action_digest"
      ],
      "properties": {
        "schema": {
          "const": "ao.architecture.autonomous-issue-repair.github-action-digest.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fork": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,255}$"
        },
        "pr_title_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pr_body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "conclusion",
              "head_sha"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "conclusion": {
                "const": "success"
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "action": {
          "enum": [
            "push_operator_fork",
            "open_upstream_draft_pr",
            "open_ready_pr",
            "request_merge_queue",
            "auto_merge"
          ]
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_envelope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "governance_decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_independence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
